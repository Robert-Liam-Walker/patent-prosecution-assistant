# Copy to .env.local and fill in.

# Database — Postgres + pgvector.
# Neon: https://console.neon.tech/ (free)
# Local: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=dev pgvector/pgvector:pg16
DATABASE_URL=postgresql://user:password@host:5432/patent_prosecution

# Generation — hosted Claude (Anthropic API).
# Compute is tiered by task; see src/lib/llm.ts. Overrides are optional.
ANTHROPIC_API_KEY=
# ANTHROPIC_REASONING_MODEL=claude-opus-5     # §102/§103 analysis, drafting (effort: xhigh)
# ANTHROPIC_DRAFTING_MODEL=claude-sonnet-5    # motions, grounded chat (effort: high/medium)
# ANTHROPIC_UTILITY_MODEL=claude-haiku-4-5    # status formatting (no effort/thinking)

# Embeddings — Voyage AI. Anthropic ships no embedding model, so retrieval
# runs on a separate provider. Must stay 1024-d to match chunks.embedding.
VOYAGE_API_KEY=
# VOYAGE_EMBED_MODEL=voyage-law-2

# USPTO Open Data Portal (optional — for "Get status" action only)
USPTO_ODP_KEY=

# Cloudflare R2 (optional — local ./uploads/ used if blank)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=patent-prosecution-docs

# App
NEXT_PUBLIC_APP_NAME=Patent Prosecution Assistant
